# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# bundled scheduler output (built inside the Docker image)
/dist

# database
/data

# playwright e2e (per-worker DBs + servers, saved auth state, reports/artifacts)
/e2e/.data
# The per-worker signed-in storage state (#1538) — session cookies, never committable.
/e2e/.auth
/test-results
/playwright-report
/blob-report
/playwright/.cache

# local claude settings
.claude/settings.local.json

# Agent worktrees. A coding agent that checks out its branch here leaves a whole
# second copy of the repo sitting untracked inside the first one — which reads as
# "uncommitted work" to anything watching the tree, and is a `git add -A` away
# from being committed into itself.
/.claude/worktrees/

# PHI-scan optional denylist of real names/orgs (see scripts/phi-scan.ts).
# Must never be committed — it would itself introduce PHI.
.phi-denylist

# Next 16: separate distDir for the e2e demo dev instance
/.next-demo/
*.traineddata
