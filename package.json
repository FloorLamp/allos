    "gen:drug-allergy": "tsx scripts/gen-drug-allergy.ts",
    "gen:medication-monitoring": "tsx scripts/gen-medication-monitoring.ts",
    "gen:radiation-dose": "tsx scripts/gen-radiation-dose.ts",
    "gen:screenings": "tsx scripts/gen-screenings.ts",
