    "gen:fitness-norms": "tsx scripts/gen-fitness-norms.ts",
    "gen:fitness-hold-norms": "tsx scripts/gen-fitness-hold-norms.ts",
    "gen:bp-percentiles": "tsx scripts/gen-bp-percentiles.ts",
