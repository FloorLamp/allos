{
  "name": "allos",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "eslint . --cache --cache-strategy content --cache-location .cache/eslint/",
    "typecheck": "next typegen && node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:db:coverage": "vitest run --config vitest.db.config.ts --coverage",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check . --cache --cache-strategy content --cache-location .cache/prettier",
    "phi-scan": "tsx scripts/phi-scan.ts",
    "reconcile": "tsx scripts/orchestration/reconcile-tracker.ts",
    "reconcile:apply": "tsx scripts/orchestration/reconcile-apply.ts",
    "schema:dump": "tsx scripts/schema-dump.ts",
    "census:dose-amounts": "tsx scripts/dose-amount-census.ts",
